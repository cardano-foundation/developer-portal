# --- Server ---------------------------------------------------------------
# The preprod address that receives payments (addr_test1...).
SELLER_ADDRESS=
# The hosted Cardano Foundation facilitator URL will be announced before the
# hackathon. Until then, run one locally: npm run facilitator
FACILITATOR_URL=http://localhost:4022

# --- Browser --------------------------------------------------------------
# Free preprod project ID from blockfrost.io. NEXT_PUBLIC_ because the
# browser paywall builds the transaction client-side; a free preprod key in
# the browser is fine.
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=
