# --- Server ---------------------------------------------------------------
# The preprod address that receives payments (addr_test1...).
SELLER_ADDRESS=
# The facilitator that verifies and settles payments: the Cardano
# Foundation's hosted one on preprod. To run one locally instead, use
# npm run facilitator and set http://localhost:4022.
FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
# Free preprod project ID from blockfrost.io. Server-only: the paywall reaches
# Blockfrost through the /api/blockfrost route, and a local facilitator, if
# you run one, uses it to submit payments. It never reaches the browser.
BLOCKFROST_PROJECT_ID=
