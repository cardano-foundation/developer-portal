# --- Server ---------------------------------------------------------------
# The preprod address that receives payments (addr_test1...).
SELLER_ADDRESS=
# The facilitator that verifies and settles payments. Run one locally with
# npm run facilitator, or point this at a hosted facilitator.
FACILITATOR_URL=http://localhost:4022
# Free preprod project ID from blockfrost.io. Server-only: the paywall reaches
# Blockfrost through the /api/blockfrost route, and the local facilitator
# uses it to submit payments. It never reaches the browser.
BLOCKFROST_PROJECT_ID=
