    "aiken_design_patterns/merkelized_validator/ComputationRedeemer<voucher/QuoteInput,Int>": {
      "title": "ComputationRedeemer",
      "description": "Datatype for redeemer of the \"computation staking validator\" to represent\n input argument(s) and output value(s).\n\n As a simple example, a summation logic where it adds all its inputs\n together, can work with a redeemer of\n type `ComputationRedeemer<List<Int>, Int>`, and a valid redeemer data would\n be:\n ```aiken\n let valid_summation_io =\n   ComputationRedeemer {\n     input_arg: [1, 2, 3, 4, 5],\n     result: 15,\n   }\n ```",
      "anyOf": [
        {
          "title": "ComputationRedeemer",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "input_arg",
              "$ref": "#/definitions/voucher~1QuoteInput"
            },
            {
              "title": "result",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "aiken_design_patterns/merkelized_validator/ValidationRedeemer<ByteArray>": {
      "title": "ValidationRedeemer",
      "description": "Datatype for a delegated validation. Compared to `ComputationRedeemer`, this\n datatype only carries input argument(s), and simply validates whether the\n computation passes.",
