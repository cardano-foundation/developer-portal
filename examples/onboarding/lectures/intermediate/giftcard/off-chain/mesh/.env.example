# A Blockfrost project key for the Preview network. Create one at https://blockfrost.io
# No VITE_ prefix on purpose: only the backend reads it, never the browser.
BLOCKFROST_API_KEY=previewYourKeyHere

# Network id: 0 = testnet (Preview / Preprod), 1 = mainnet
# This one is safe to publish, so the browser may read it.
VITE_NETWORK_ID=0
