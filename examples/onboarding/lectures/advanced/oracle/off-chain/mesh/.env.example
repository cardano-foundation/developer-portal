# A Blockfrost project key for the network below. Create one at https://blockfrost.io
# No VITE_ prefix on purpose: only the operator scripts and the proxy read it.
BLOCKFROST_API_KEY=preprodYourKeyHere

# The network everything runs on: preview, preprod or mainnet. The key above has
# to belong to the same one. Safe to publish, so the browser may read it.
VITE_NETWORK=preprod

# The operator's recovery phrase, from `npm run operator:new`. Only the operator
# scripts read it. Never the browser, and never a commit.
OPERATOR_MNEMONIC=
