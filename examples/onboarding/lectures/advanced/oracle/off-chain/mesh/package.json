{
  "name": "onboarding-oracle-production-mesh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Intermediate oracle taken to Preprod: operator scripts that deploy, update and monitor it, a deployment record, and a browser app for its users, built with Mesh.",
  "scripts": {
    "test": "node --test 'src/*.test.ts'",
    "typecheck": "tsc",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "operator:new": "node scripts/new-operator.ts",
    "deploy": "node scripts/deploy.ts",
    "update": "node scripts/update.ts",
    "monitor": "node scripts/monitor.ts"
  },
  "dependencies": {
    "@meshsdk/core": "^1.9.1",
    "@meshsdk/core-csl": "^1.9.1",
    "@meshsdk/wallet": "^1.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.23.0"
  },
  "overrides": {
    "libsodium-wrappers-sumo": "^0.8.4"
  }
}
